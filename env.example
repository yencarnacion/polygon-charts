# .env
POLYGON_API_KEY=<your key>
FMP_API_KEY=<your key>
SEC_API_KEY=<your key>
MARKETAUX_API_KEY=<your key>   # optional; omit to hide Marketaux Catalyst Radar panels
PORT=8081          # (optional) – you can also keep using -port flag
PATTERNFOLIO_URL=http://localhost:8082
NTFY_ENABLED=false
NTFY_SERVER=push.example.com   # use http://push.example.com for a non-TLS ntfy server
NTFY_TOPIC=hello
