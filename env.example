# .env
POLYGON_API_KEY=<your key>
FMP_API_KEY=<your key>
# SEC filings default to the free SEC EDGAR API (no account or API key).
SEC_FILINGS_PROVIDER=edgar
# Required identification for EDGAR requests: replace with your app name/contact email.
SEC_USER_AGENT="Polygon Charts your-email@example.com"
# Optional paid provider: set SEC_FILINGS_PROVIDER=sec-api and supply this key.
# An existing key alone does not enable sec-api.io or act as an automatic fallback.
SEC_API_KEY=
RTPR_API_KEY=                 # optional; enables RTPR news/press releases (Pro API access)
MARKETAUX_API_KEY=<your key>   # optional; omit to hide Marketaux Catalyst Radar panels
PORT=8081          # (optional) – you can also keep using -port flag
PATTERNFOLIO_URL=http://localhost:8082
NTFY_ENABLED=false
NTFY_SERVER=push.example.com   # use http://push.example.com for a non-TLS ntfy server
NTFY_TOPIC=hello
# Optional generic integration. Polygon Charts POSTs {"symbol":"AAPL"} to
# this receiver through its same-origin backend and shows SYMBOL_ACTION_LABEL.
SYMBOL_ACTION_URL=http://127.0.0.1:8090/api/symbol
SYMBOL_ACTION_LABEL=Send symbol

# Optional TradingView Desktop integration. Disabled by default because this is
# a public repository. Launch TradingView with its loopback CDP port first.
POLYGON_CHARTS_TRADINGVIEW_ENABLED=false
POLYGON_CHARTS_TRADINGVIEW_CDP_URL=http://127.0.0.1:9222
POLYGON_CHARTS_TRADINGVIEW_TIMEOUT=3s
